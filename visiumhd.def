Bootstrap: docker
From: ubuntu:22.04

%post
    # Install system packages
    apt-get update && apt-get install -y \
        python3 python3-pip python3-venv \
        build-essential git curl unzip \
        libglib2.0-0 libsm6 libxrender1 libxext6 \
        libgl1-mesa-glx \
        && apt-get clean

    # Create a virtual environment
    python3 -m venv /opt/venv
    . /opt/venv/bin/activate

    # Upgrade pip and install Python packages
    pip install --upgrade pip

    # Install Jupyter and spatial packages
    pip install \
        jupyterlab ipykernel notebook \
        scanpy squidpy napari[all] \
        spatialdata spatialdata[extra] spatialdata[torch]

    # Register Jupyter kernel inside venv
    python -m ipykernel install --prefix=/opt/venv --name=visiumhd-env

%environment
    # Activate the venv automatically
    source /opt/venv/bin/activate

%runscript
    exec jupyter lab --ip=0.0.0.0 --port=8888 --no-browser --NotebookApp.token=''
